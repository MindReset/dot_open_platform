            "en-US": {
              "name": "Quote/0",
              "alias": "Early Bird Edition"
            },
            "ja-JP": {
              "name": "Quote/0",
              "alias": "先発版です"
            }
          }
        }
      ],
      "resolution": {
        "width": 152,
        "height": 296,
        "unit": "px"
      },
      "colors": ["white", "black"],
      "bitsPerPixel": 1,
      "bufferSizeBytes": 5624,
      "bus": "SPI"
    },
    "enclosure": {
      "availableFormats": ["STEP", "STL"],
      "unit": "mm"
    }
  },
  "licenses": {
