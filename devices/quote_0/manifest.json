      "controllers": [
        {
          "variant": "standard",
          "label": "Standard edition",
          "controller": "UC8251D",
          "driver": "firmware-resources/display/drivers/uc8251d_minimal.c"
        },
        {
          "variant": "early_bird",
          "label": "Early Bird Edition",
          "controller": "UC8151/IL0324",
          "driver": "firmware-resources/display/drivers/uc8151_minimal.c",
          "appEditionLabels": {
            "zh-Hans-CN": {
              "name": "摘录/0",
              "alias": "首发版"
